# Copy to .env.local (never commit .env.local)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: comma-separated model lists, tried in order. Leave empty for the defaults
# in src/adapters/llm/index.ts. Run `npx tsx scripts/llm-check.ts` to see what your keys can use.
GEMINI_MODEL=
GROQ_CHAT_MODEL=
GROQ_VISION_MODEL=
# Required in production: any long random string; signs order and consent links.
ORDER_SECRET=

# Demo back-office sign-in (defaults: partner PIN 1234, ADMIN / 9999)
# PARTNER_DEMO_PIN=1234
# ADMIN_DEMO_PIN=9999

# Shared storage (recommended on Vercel): Upstash Redis, free tier. Adding it from the Vercel
# Storage tab sets these two automatically. Without them, queues and status updates live on
# one server instance only (fine for `npm run dev`).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# WhatsApp (optional). Twilio sandbox: anyone joins by sending the join code to the sandbox number.
# Twilio Console → Messaging → Try it out → Send a WhatsApp message. Webhook "When a message comes in":
#   https://<your-app>.vercel.app/api/whatsapp/twilio  (POST)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# TWILIO_SANDBOX_JOIN=join your-two-words
# Meta WhatsApp Cloud API (production path): webhook https://<your-app>.vercel.app/api/whatsapp/meta
# META_WA_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_VERIFY_TOKEN=
# META_APP_SECRET=
# PUBLIC_ORIGIN=https://udyam-digital-lilac.vercel.app   # optional: address used in WhatsApp links
