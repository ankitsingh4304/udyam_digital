# Copy to .env.local (never commit .env.local)
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: comma-separated model lists, tried in order. Leave empty for the defaults
# in src/adapters/llm/index.ts. Run `npx tsx scripts/llm-check.ts` to see what your keys can use.
GEMINI_MODEL=
GROQ_CHAT_MODEL=
GROQ_VISION_MODEL=
# Required in production: any long random string; signs order and consent links.
ORDER_SECRET=
